{
  "_comment": "Sample webhook payloads — 2g signing format (t=<ts>,v1=<hex>)",
  "_comment_last_verified": "2026-05-20",
  "_signature_format": {
    "algorithm": "HMAC-SHA256",
    "input": "'{timestamp}.{JSON.stringify(body)}' — body is { event, institutionId, payload }",
    "key": "per-webhook secret (returned once at POST /v1/webhooks, rotatable)",
    "header": "Irion-Signature: t=<unix_ts>,v1=<64-char-hex>",
    "header_grace_period": "Irion-Signature: t=<unix_ts>,v1=<new_key_hex>,v0=<old_key_hex>",
    "additional_headers": {
      "Idempotency-Key": "<delivery-uuid> — receiver can deduplicate",
      "Irion-Event": "deposit.confirmed | withdrawal.confirmed | loan.originated | ...",
      "Irion-Timestamp": "<ISO-8601> — UTC timestamp of delivery attempt"
    },
    "replay_protection": "Receiver verifies timestamp within ±5 minutes of its clock",
    "note": "The worker enqueues to webhookDeliveryQueue which signs (deliveryId as Idempotency-Key) and delivers asynchronously"
  },
